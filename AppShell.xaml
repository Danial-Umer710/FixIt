<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="FixIt.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FixIt.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="FixIt">

    <TabBar>
        <ShellContent Title="Reports"
                      Icon="tab_reports.png"
                      Route="reports"
                      ContentTemplate="{DataTemplate views:ReportsPage}" />
        <ShellContent Title="Map"
                      Icon="tab_map.png"
                      Route="map"
                      ContentTemplate="{DataTemplate views:MapPage}" />
    </TabBar>

</Shell>
