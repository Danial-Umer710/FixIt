<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#E8590C</Color>
    <Color x:Key="PrimaryDark">#B5450A</Color>
    <Color x:Key="PrimaryLight">#FFE8CC</Color>
    <Color x:Key="PrimaryLightDark">#5C2A0B</Color>

    <!-- Status -->
    <Color x:Key="StatusOpen">#E03131</Color>
    <Color x:Key="StatusInProgress">#F08C00</Color>
    <Color x:Key="StatusFixed">#2F9E44</Color>
    <Color x:Key="Danger">#E03131</Color>
    <Color x:Key="Info">#1971C2</Color>

    <!-- Neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F1F3F5</Color>
    <Color x:Key="Gray200">#E9ECEF</Color>
    <Color x:Key="Gray300">#DEE2E6</Color>
    <Color x:Key="Gray500">#ADB5BD</Color>
    <Color x:Key="Gray600">#868E96</Color>
    <Color x:Key="Gray700">#495057</Color>
    <Color x:Key="Gray800">#343A40</Color>
    <Color x:Key="Gray900">#212529</Color>

    <!-- Surfaces -->
    <Color x:Key="PageLight">#F8F9FA</Color>
    <Color x:Key="PageDark">#121212</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1E1E1E</Color>
    <Color x:Key="CardStrokeLight">#E9ECEF</Color>
    <Color x:Key="CardStrokeDark">#2C2C2C</Color>
    <Color x:Key="TextLight">#212529</Color>
    <Color x:Key="TextDark">#F1F3F5</Color>
    <Color x:Key="TextSecondaryLight">#6C757D</Color>
    <Color x:Key="TextSecondaryDark">#ADB5BD</Color>

</ResourceDictionary>
