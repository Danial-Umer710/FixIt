<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FixIt.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FixIt.ViewModels"
             xmlns:models="clr-namespace:FixIt.Models"
             x:DataType="vm:ReportsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Network connectivity: offline banner -->
        <Border Grid.Row="0" Style="{StaticResource OfflineBanner}" IsVisible="{Binding IsOffline}">
            <Label Text="📴  You're offline. Reports are saved on this device and their addresses are filled in automatically when you reconnect."
                   TextColor="White" FontSize="13" />
        </Border>

        <!-- Statistics -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="16,14,16,4">
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Text="{Binding OpenCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource StatusOpen}" />
                    <Label Text="Open" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Text="{Binding InProgressCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource StatusInProgress}" />
                    <Label Text="In progress" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Text="{Binding FixedCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource StatusFixed}" />
                    <Label Text="Fixed" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Search -->
        <SearchBar Grid.Row="2"
                   Margin="6,4,6,0"
                   Placeholder="Search title, address, category…"
                   Text="{Binding SearchText}" />

        <!-- Status filter chips -->
        <CollectionView Grid.Row="3"
                        Margin="16,4,16,6"
                        HeightRequest="44"
                        ItemsSource="{Binding Filters}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource Chip}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryLightDark}}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding .}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Report list -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Reports}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedReport, Mode=TwoWay}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:IssueReport">
                        <SwipeView Padding="16,5">
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}, Path=DeleteReportCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}" Padding="10">

                                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                    <!-- Photo thumbnail, or category icon when there is no photo -->
                                    <Border WidthRequest="64" HeightRequest="64"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                        <Grid>
                                            <Label Text="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                                   FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LocationSummary}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Caption}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Severity, Converter={StaticResource SeverityToText}}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Start"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColor}}">
                                        <Label Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                               TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Empty state (explicit panel: CollectionView.EmptyView is unreliable inside RefreshView on Windows) -->
        <VerticalStackLayout Grid.Row="4"
                             IsVisible="{Binding IsEmpty}"
                             InputTransparent="True"
                             Padding="40,50" Spacing="8"
                             HorizontalOptions="Center" VerticalOptions="Start"
                             MaximumWidthRequest="460">
            <Label Text="🚧" FontSize="52" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyTitle}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Create -->
        <Button Grid.Row="4"
                Text="+"
                Style="{StaticResource FabButton}"
                Margin="0,0,20,20"
                SemanticProperties.Description="Create a new report"
                Command="{Binding AddReportCommand}" />
    </Grid>
</ContentPage>
